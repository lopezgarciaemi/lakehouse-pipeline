# ==============================================================================
# Financial Lakehouse Pipeline - Environment Configuration
# Copy this file to .env before running docker compose up
# ==============================================================================

# Storage Mode: "local" (filesystem Parquet) or "s3" (MinIO S3 in Docker)
STORAGE_BACKEND=s3
LOCAL_LAKEHOUSE_DIR=./data/lakehouse

# MinIO (S3-Compatible Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=lakehouse

# Simulated Fintech OLTP Database (PostgreSQL)
OLTP_POSTGRES_USER=fintech_user
OLTP_POSTGRES_PASSWORD=fintech_pass
OLTP_POSTGRES_DB=fintech_oltp
OLTP_DB_URI=postgresql+psycopg2://fintech_user:fintech_pass@postgres-oltp:5432/fintech_oltp

# Airflow Metadata Database (PostgreSQL)
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Analytical Warehouse (DuckDB)
DUCKDB_PATH=/opt/airflow/data/warehouse/financial_lakehouse.duckdb

# External FX API (Frankfurter - Public ECB Reference Rates)
FX_API_BASE_URL=https://api.frankfurter.app

# Data Quality Circuit Breaker (Max allowed invalid rows ratio before halting)
MAX_QUARANTINE_RATIO=0.30

# Optional Webhook URL (Slack / Discord / Microsoft Teams) for failure alerts
ALERT_WEBHOOK_URL=
